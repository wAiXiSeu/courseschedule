# 课程表 MCP 服务配置（复制为 packages/mcp/.env 后填写真实值）
# 也可以在 MCP 客户端（Qoder / Claude Desktop 等）的 env 配置里直接提供同名变量，
# 进程环境变量优先于本文件。

# Supabase 项目配置（与 packages/web/.env 里的值相同）
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 家长账号：MCP 服务以该身份登录，RLS 限定其可见的家庭空间
# 建议使用家长账号而非孩子账号，审批兑换、手工加减分都以该身份记录
SUPABASE_EMAIL=
SUPABASE_PASSWORD=

# 可选：账号可见多个家庭空间时必填；只有一个时自动选中
FAMILY_ID=

# 可选：默认孩子 ID（与 web 端一致，默认 default-child）
CHILD_ID=

# 可选：时区，影响「今天」的判定；默认取系统时区
# TZ=Asia/Shanghai

# ─────────────── HTTP 模式（远程部署）───────────────
# 仅启动 dist/http.js 时需要；stdio 模式忽略这些变量。
# 固定 bearer token：客户端须带 Authorization: Bearer <token> 才能访问 /mcp。
# 生成一个随机值：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_HTTP_TOKEN=

# 可选：监听端口，默认 8787
MCP_HTTP_PORT=8787

# 可选：监听地址，默认 127.0.0.1（仅本机/nginx 可达，不直接暴露公网）
# 远程部署建议保持 127.0.0.1，由 nginx 反代并终止 TLS
MCP_HTTP_HOST=127.0.0.1