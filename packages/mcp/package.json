{
  "name": "@courseschedule/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "课程表 MCP 服务：让 agent 查询课程表、打卡、管理积分",
  "bin": {
    "courseschedule-mcp": "dist/index.js",
    "courseschedule-mcp-http": "dist/http.js"
