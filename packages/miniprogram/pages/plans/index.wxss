/**
 * 学习计划页面样式
 */
.header {
  padding: 20rpx 0;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
}

.empty-card {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  display: block;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 16rpx;
}

.plan-card {
  position: relative;
}

.plan-name {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
}

.plan-course {
  font-size: 26rpx;
  color: #1E88E5;
  display: block;
  margin-top: 8rpx;
}

.plan-date {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.plan-progress {
  margin-top: 16rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: #1E88E5;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}
