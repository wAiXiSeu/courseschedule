/**
 * 打卡页面样式
 */
.title {
  font-size: 34rpx;
  font-weight: bold;
  display: block;
}

.date {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-top: 8rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.picker-btn {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.placeholder {
  color: #999;
}

.input {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.empty {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
}
