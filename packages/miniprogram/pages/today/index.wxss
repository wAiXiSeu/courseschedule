/**
 * 今日页面样式 —— 儿童友好风格
 * 大圆角、鲜明色彩、大字体
 */

.page-container {
  padding: 20rpx 24rpx;
  padding-bottom: 40rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ─── 顶部信息栏 ─── */

.header-card {
  background: linear-gradient(135deg, #1E88E5 0%, #42A5F5 100%);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 136, 229, 0.3);
}

.header-top {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.header-emoji {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.header-stats {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.stat-badge {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
}

.stat-emoji {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.stat-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ─── 本周打卡格子 ─── */

.section-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-emoji {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
}

.week-strip-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.day-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.day-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.day-circle.checked {
  background: #43A047;
}

.day-circle.unchecked {
  background: #E8EAF6;
}

.day-check {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 700;
}

.day-label {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

/* ─── 区域标题 ─── */

.section {
  margin-bottom: 12rpx;
}

.section-heading {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.divider {
  height: 1rpx;
  background: #E8EAF6;
  margin: 28rpx 0;
}

/* ─── 课程时间轴 ─── */

.timeline {
  padding-left: 8rpx;
}

.timeline-item {
  display: flex;
  min-height: 160rpx;
}

.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  margin-right: 20rpx;
  padding-top: 8rpx;
}

.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.timeline-line {
  width: 4rpx;
  flex: 1;
  background: #E8EAF6;
  margin-top: 8rpx;
  border-radius: 2rpx;
}

.timeline-right {
  flex: 1;
  padding-bottom: 24rpx;
}

.timeline-time {
  margin-bottom: 12rpx;
}

.time-text {
  font-size: 26rpx;
  color: #666;
  font-weight: 600;
}

.time-sep {
  font-size: 26rpx;
  color: #999;
}

/* ─── 任务清单 ─── */

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
  border-left: 6rpx solid #1E88E5;
}

.task-card.done {
  opacity: 0.65;
  border-left-color: #BDBDBD;
}

.task-card.overdue {
  border-left-color: #E53935;
}

.task-checkbox {
  margin-right: 20rpx;
  flex-shrink: 0;
}

.checkbox-inner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid #BDBDBD;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.checkbox-inner.checked {
  background: #43A047;
  border-color: #43A047;
}

.check-mark {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 700;
}

.task-info {
  flex: 1;
  overflow: hidden;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-title.line-through {
  text-decoration: line-through;
  color: #999;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.task-source {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.source-plan {
  background: #E3F2FD;
  color: #1565C0;
}

.source-review {
  background: #FFF3E0;
  color: #E65100;
}

.task-due-badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: #FFEBEE;
  color: #C62828;
  font-weight: 600;
}

/* ─── 空状态 ─── */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-emoji {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* ─── 加载状态 ─── */

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 30rpx;
  color: #999;
}
