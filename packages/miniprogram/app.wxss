/**
 * 全局样式
 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial,
    sans-serif;
  font-size: 28rpx;
  color: #333;
  background-color: #f5f5f5;
  line-height: 1.5;
}

.container {
  padding: 20rpx;
}

/* 通用卡片样式 */
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 主按钮样式 */
.btn-primary {
  background: #1E88E5;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
}

.btn-primary:active {
  opacity: 0.8;
}
