<!-- 周选择条组件 -->
<view class="week-strip">
  <view class="arrow-btn" bind:tap="onPrevWeek">
    <text class="arrow-icon">◀</text>
  </view>
  <view class="week-display">
    <text class="week-text">{{_displayText}}</text>
  </view>
  <view class="arrow-btn" bind:tap="onNextWeek">
    <text class="arrow-icon">▶</text>
  </view>
</view>
