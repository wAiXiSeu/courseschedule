/**
 * 周选择条组件样式
 */

:host {
  display: block;
}

.week-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 20rpx;
}

.arrow-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  border-radius: 50%;
  transition: all 0.2s;
}

.arrow-btn:active {
  background: #e0e0e0;
  transform: scale(0.95);
}

.arrow-icon {
  font-size: 28rpx;
  color: #1E88E5;
  font-weight: 700;
}

.week-display {
  flex: 1;
  text-align: center;
  padding: 0 20rpx;
}

.week-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  letter-spacing: 1rpx;
}
